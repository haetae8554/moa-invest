# Windows: automatically reuse the existing Credential Manager entries.
# Never put real API keys into this template or commit a populated .env file.
# Lookup order: dedicated Moa Windows vault -> process/.env -> Windows environment -> legacy vault.
# UI-registered Moa keys use memory-only tokens and ignore the legacy token cache.
TOSS_KEYRING_SERVICE=stock_llm_alert_project
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=
TOSS_ORDER_EXECUTION_ENABLED=false
# Legacy single-order method only. Batch methods split into $9 orders; no daily cap.
TOSS_FRACTIONAL_ORDER_MAX_USD=9.99
TOSS_DATA_DIR=data
# OAuth tokens are memory-only by default.
# Legacy compatibility only: explicit caches contain plaintext bearer tokens.
# Set a protected, local path only when sharing a cache is necessary.
# TOSS_TOKEN_CACHE_PATH=
