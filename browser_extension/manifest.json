{
  "manifest_version": 3,
  "name": "모아 · 토스 종목 연결",
  "version": "0.5.1",
  "description": "토스 탭 옆에서 모아를 사용합니다. Windows 연결 도구를 한 번 등록하면 로컬 서버가 자동 실행됩니다.",
  "minimum_chrome_version": "141",
  "permissions": [
    "storage",
    "sidePanel",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://tossinvest.com/*",
    "https://www.tossinvest.com/*",
    "https://wts-info-api.tossinvest.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "모아 종목 연결",
    "default_icon": {
      "16": "icons/moa-16.png",
      "32": "icons/moa-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://tossinvest.com/*",
        "https://www.tossinvest.com/*"
      ],
      "js": [
        "protocol.js",
        "toss.js"
      ]
    },
    {
      "matches": [
        "http://127.0.0.1:8765/*",
        "http://localhost:8765/*"
      ],
      "js": [
        "protocol.js",
        "moa.js"
      ]
    }
  ],
  "key": "",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src http://127.0.0.1:8765; connect-src 'self' https://wts-info-api.tossinvest.com"
  },
  "icons": {
    "16": "icons/moa-16.png",
    "32": "icons/moa-32.png",
    "48": "icons/moa-48.png",
    "128": "icons/moa-128.png"
  }
}
